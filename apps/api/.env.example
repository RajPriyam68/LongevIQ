# LongevIQ API environment variables
NODE_ENV=development
PORT=4000
API_PREFIX=/api
API_VERSION=v1
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Placeholders for upcoming Sprints (do not fill yet) ---
DATABASE_URL=postgresql://longeviq:longeviq@localhost:5432/longeviq?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
