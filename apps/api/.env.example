# LongevIQ API environment variables
NODE_ENV=development
PORT=4000
API_PREFIX=/api
API_VERSION=v1
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# PostgreSQL
DATABASE_URL=postgresql://longeviq:longeviq@localhost:5432/longeviq?schema=public

# --- Authentication (Sprint 1) ---
# HS256 signing secret for access tokens (min 32 chars). In development and test,
# a random secret is auto-generated when left blank; production requires it.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque, DB-backed values; they do not use a JWT secret.
JWT_REFRESH_TTL_DAYS=7

# Public origin of the web app (used to build verification links and OAuth redirects)
FRONTEND_URL=http://localhost:3000
# Mark auth cookies as Secure (set true behind HTTPS in production)
COOKIE_SECURE=false

# Google OAuth (Sprint 1) - leave blank to disable the Google sign-in button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (Sprint 1) - verification emails. When SMTP is unset, the
# verification link is logged to the server console and returned in the API
# response in non-production environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LongevIQ <no-reply@longeviq.dev>

# --- Medical report storage (Sprint 3) ---
# Local directory where uploaded report files are written when S3_BUCKET is
# unset (development/test). Defaults to <api cwd>/.uploads.
STORAGE_UPLOAD_DIR=
# Maximum size of an uploaded report file in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760
# When S3_BUCKET is set, report files are stored in S3 instead of locally.
# S3_REGION (or S3_ENDPOINT for S3-compatible stores) is required in that case.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI health assistant (Sprint 6) ---
# OpenAI-compatible chat-completions provider used by the AI health assistant.
# Credentials are user-supplied at runtime; leave USER_LLM_API_KEY blank to keep
# the assistant in its graceful "not configured" mode (no AI chat enabled).
USER_LLM_API_KEY=
# Base URL of an OpenAI-compatible API (defaults to https://api.openai.com/v1).
USER_LLM_BASE_URL=
# Model name (defaults to gpt-4o-mini).
USER_LLM_MODEL=
# Upstream request timeout in milliseconds (default 60000).
LLM_TIMEOUT_MS=60000
# RAG retrieval + prompt knobs for the assistant.
ASSISTANT_RETRIEVAL_TOP_K=4
ASSISTANT_CONTEXT_CHAR_LIMIT=12000
ASSISTANT_HISTORY_MESSAGES=12
# Per-user chat rate limiting (defaults to 30 messages/minute).
ASSISTANT_CHAT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_CHAT_RATE_LIMIT_MAX=30
