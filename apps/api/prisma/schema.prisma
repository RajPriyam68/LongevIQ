// LongevIQ Prisma schema
// Datasource, generators, and models.
// Sprint 1: User, RefreshToken, EmailVerificationToken, AuditLog.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DOCTOR
  ADMIN
}

enum HealthMetricType {
  BLOOD_PRESSURE
  HEART_RATE
  WEIGHT
  BLOOD_GLUCOSE
  BMI
  SLEEP_HOURS
  STEPS
  BODY_TEMPERATURE
}

enum ReportStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED
}

enum ReportCategory {
  BLOODWORK
  IMAGING
  GENERAL
  OTHER
}

enum ReportFindingFlag {
  NORMAL
  HIGH
  LOW
}

enum KnowledgeCategory {
  METRICS
  LABS
  NUTRITION
  WELLNESS
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  oauthProvider String?
  oauthId       String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]
  healthMetrics           HealthMetric[]
  reports                 MedicalReport[]
  knowledgeDocuments      KnowledgeDocument[]
  chatSessions            ChatSession[]

  @@index([oauthProvider, oauthId])
}

model HealthMetric {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           HealthMetricType
  value          Float
  valueSecondary Float?
  unit           String
  recordedAt     DateTime
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, type, recordedAt])
}

model MedicalReport {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  reportDate      DateTime
  source          String?
  category        ReportCategory @default(OTHER)
  notes           String?
  status          ReportStatus   @default(UPLOADED)
  fileName        String
  fileSizeBytes   Int
  mimeType        String
  storageKey      String         @unique
  parsedText      String?
  processingError String?
  parsedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  findings ReportFinding[]

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([status])
}

model ReportFinding {
  id             String             @id @default(cuid())
  reportId       String
  report         MedicalReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name           String
  value          String
  unit           String?
  referenceRange String?
  flag           ReportFindingFlag?
  confidence     Float
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  @@index([reportId])
}

model KnowledgeDocument {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  summary       String?
  category      KnowledgeCategory @default(WELLNESS)
  source        String?
  status        KnowledgeStatus   @default(DRAFT)
  language      String            @default("english")
  createdBy     String?
  createdByUser User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  chunks        KnowledgeChunk[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, category])
}

model KnowledgeChunk {
  id           String                   @id @default(cuid())
  documentId   String
  document     KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex   Int
  title        String?
  content      String
  // Full-text search vector, populated by the knowledge repository on insert
  // (Prisma Unsupported type; writes go through raw SQL). The GIN index below
  // backs the FTS retrieval engine. A pgvector embedding column will be added
  // here when the semantic layer ships (see docs/SECURITY.md).
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())

  @@index([documentId, chunkIndex])
  @@index([searchVector], type: Gin)
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  // Retrieval provenance: the knowledge chunks (and their documents) that
  // grounded the assistant answer. Null when no sources were used.
  sources   Json?
  // True when the assistant reply is a fallback/error notice (e.g. the LLM
  // provider is not configured or the upstream call failed).
  isError   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([sessionId, createdAt])
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
