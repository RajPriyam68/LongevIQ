NODE_ENV=test
PORT=4100
API_PREFIX=/api
API_VERSION=v1
LOG_LEVEL=silent
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# Tests default to the local test database; CI overrides with its service DB.
