# LongevIQ Web environment variables

# Public API base URL used by the browser.
# Leave empty to use the Next.js rewrite (/api/v1 -> backend).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Base URL of the backend API (used by the Next.js rewrite target).
# NEXT_PUBLIC_API_URL=http://localhost:4000
